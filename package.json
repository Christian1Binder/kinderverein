{
  "name": "kinderverein-projektzentrale",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prepare:source": "node scripts/restore-source.mjs",
    "build": "npm run prepare:source && vite build",
    "build:pages": "npm run prepare:source && vite build --base=/kinderverein/ --outDir dist",
    "build:strato": "npm run prepare:source && vite build --base=./ --outDir dist-strato",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.7"
  }
}
